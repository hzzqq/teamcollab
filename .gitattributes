# 统一换行符为 LF，避免 Windows 下 checkout 时 CRLF 噪声与跨平台 diff 抖动
* text=auto eol=lf

# 明确按文本处理
*.py text
*.ts text
*.tsx text
*.js text
*.json text
*.css text
*.md text
*.yaml text
*.yml text
*.html text
*.mjs text

# 二进制不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
